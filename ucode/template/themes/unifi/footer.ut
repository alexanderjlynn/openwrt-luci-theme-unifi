		{% if (!blank_page): %}
				<footer class="unifi-footer">
					<span>{{ version.luciname }} {{ version.luciversion }}</span>
					<span>{{ version.distname }} {{ version.distversion }}</span>
					{% if (lua_active): %}<span>{{ _('Lua compatibility mode active') }}</span>{% endif %}
				</footer>
			</main>
		</div>
		<div id="unifi-command" class="unifi-command" role="dialog" aria-modal="true" aria-label="{{ _('Search navigation') }}" hidden>
			<div class="unifi-command-panel">
				<label><svg viewBox="0 0 24 24" aria-hidden="true"><use href="{{ media }}/icons.svg#unifi-search"></use></svg><input id="unifi-command-input" type="search" autocomplete="off" placeholder="{{ _('Search settings and pages…') }}"><kbd>Esc</kbd></label>
				<ul id="unifi-command-results"></ul>
				<p>{{ _('Type to filter · Enter to open') }}</p>
			</div>
		</div>
		<script>
			// LuCI normally keys module caching to luci-base. Include the theme
			// version so an APK theme upgrade also refreshes its menu module.
			L.env.resource_version = (L.env.resource_version || '') + '-unifi-{# PKG_VERSION #}';
			L.require('menu-unifi');
		</script>
		{% endif %}
	</body>
</html>
